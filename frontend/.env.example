# URL of the FastAPI backend (../backend). When unset, the Next.js API routes return stub jobs.
BACKEND_URL=http://localhost:8000

# Deployed (Vercel + Cloudflare tunnel): the backend's public URL. The browser then uploads videos and plays
# results straight from it, since Vercel Functions cap bodies at 4.5 MB. Inlined at build time, so redeploy
# after changing it. Leave it unset locally.
# NEXT_PUBLIC_API_URL=https://<random>.trycloudflare.com

# Set to 1 for judging: every submission returns the cached sample-clip result instantly
# (frontend/lib/demo-jobs.json + public/demo/*.mp4). The demos at /jobs/demo-breakdown and
# /jobs/demo-autocut work without it.
DEMO_MODE=0
